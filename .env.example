# Copie para .env.local e preencha. Nunca versione credenciais.

# Domínio confirmado (sem barra final). Habilita canonical, sitemap e url no JSON-LD.
NEXT_PUBLIC_SITE_URL=

# "true" somente no deploy de produção com domínio confirmado. Qualquer outro valor = noindex.
SITE_INDEXABLE=false

# Envio do formulário via Resend (https://resend.com). Sem as três variáveis,
# o formulário opera em modo de demonstração e NÃO confirma envio.
RESEND_API_KEY=
# Caixa que recebe os contatos (definida pelo escritório).
CONTACT_TO_EMAIL=
# Remetente em domínio verificado no Resend, ex.: "Site Campos Visnadi <site@dominio-confirmado>"
CONTACT_FROM_EMAIL=

# Somente desenvolvimento: força falha do provedor para testar o estado de erro.
CONTACT_FORCE_FAILURE=false
